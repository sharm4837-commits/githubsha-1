def union_sorted_arrays(arr1, arr2):
    i, j = 0, 0
    result = []
    n1, n2 = len(arr1), len(arr2)
    
    while i < n1 and j < n2:
        if arr1[i] <= arr2[j]:
            if not result or result[-1] != arr1[i]:
                result.append(arr1[i])
            i += 1
        else:
            if not result or result[-1] != arr2[j]:
                result.append(arr2[j])
            j += 1
    
    while i < n1:
        if not result or result[-1] != arr1[i]:
            result.append(arr1[i])
        i += 1
    
    while j < n2:
        if not result or result[-1] != arr2[j]:
            result.append(arr2[j])
        j += 1
    
    return result


arr1 = [1, 2, 3, 4, 5]
arr2 = [2, 3, 4, 4, 5, 6]
print(union_sorted_arrays(arr1, arr2)) 
